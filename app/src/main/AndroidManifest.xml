<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the narration clips and the worksheets are fetched from the teacher's host -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Announcements: a new worksheet, a new chapter, the online exam. Asked for only when there
      is actually a notice to show, never on a first launch (see ui/Announcements).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- the subscription is bought through Bazaar's own payment screen -->
    <uses-permission android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Since Android 11 an app cannot even see another package unless it says so here. Without
      this the bind to Bazaar fails with no error worth reading, and every purchase looks like a
      connection problem.
    -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
    </queries>

    <application
        android:name=".HooHooApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HooHooMath">

        <!--
          Lets «باز کن» pass a downloaded worksheet to a PDF reader. Since Android 7 a file://
          Uri handed to another app throws, so the sheet goes out as a content:// Uri instead,
          read-only and for that one file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sheets"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.HooHooMath">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          اعلانِ فوری (Metrix). These are read by the SDK at startup — it brings up its own
          ContentProvider, so there is no init call anywhere in the code.

          The two ids come from the Metrix panel and are filled in by app/build.gradle from
          local.properties or the environment. When push is off they resolve to empty strings
          and nothing reads them, because the SDK is not in the APK either.
        -->
        <meta-data
            android:name="ir.metrix.APPLICATION_ID"
            android:value="${metrixAppId}" />
        <meta-data
            android:name="ir.metrix.SIGNATURE"
            android:value="${metrixSignature}" />
        <meta-data
            android:name="metrix_developer_mode"
            android:value="false" />

        <!-- what a pushed notification looks like when the message carries no icon of its own -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_owl_face" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/teal" />
    </application>

</manifest>
