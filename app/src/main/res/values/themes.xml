<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The design prototype uses the "Vazirmatn" Persian webfont. We default to the
      system sans-serif here (renders Persian correctly via Noto Sans Arabic fallback
      on all Android versions) since no font binary was available to embed. Drop a
      vazirmatn.ttf into res/font and switch fontFamily below to upgrade the look.
    -->
    <style name="Theme.HooHooMath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryDark">@color/teal_dark</item>
        <item name="colorAccent">@color/orange</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>
</resources>
