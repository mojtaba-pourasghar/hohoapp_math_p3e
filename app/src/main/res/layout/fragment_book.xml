<?xml version="1.0" encoding="utf-8"?>
<!--
  «کتاب» mode: the real page from the textbook on top, and the very same page's sentences
  underneath so هوهو can read them one by one.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/book_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="کتاب ریاضی سوم دبستان"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/book_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11.5sp"
            android:textColor="@color/text_muted" />

        <FrameLayout
            android:id="@+id/book_chip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <ImageView
            android:id="@+id/book_page_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_card_white"
            android:contentDescription="صفحه‌ی کتاب"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <!-- page turning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/book_prev_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:padding="13dp"
                android:text="‹ صفحه‌ی قبل"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_help_button" />

            <TextView
                android:id="@+id/book_next_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="13dp"
                android:text="صفحه‌ی بعد ›"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_help_button" />
        </LinearLayout>

        <!-- what هوهو is reading right now -->
        <TextView
            android:id="@+id/book_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="15dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="7dp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_card_teal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/book_prev_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:gravity="center"
                android:padding="13dp"
                android:text="‹ خط قبل"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_help_button" />

            <TextView
                android:id="@+id/book_read"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:gravity="center"
                android:padding="13dp"
                android:text="دوباره بخوان 🔊"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/orange_text"
                android:background="@drawable/bg_card_orange" />

            <TextView
                android:id="@+id/book_next_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="13dp"
                android:text="خط بعد ›"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_help_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/book_autoplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:padding="14dp"
            android:text="هوهو از اینجا تا آخر صفحه بخواند"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_teal" />

        <!-- every sentence on the page; tap one to jump there -->
        <LinearLayout
            android:id="@+id/book_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
