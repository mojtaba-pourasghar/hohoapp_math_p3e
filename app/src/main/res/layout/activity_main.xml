<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg_page">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nav_bar" />

    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:elevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/nav_item" android:id="@+id/nav_map" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <include layout="@layout/nav_item" android:id="@+id/nav_sections" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <include layout="@layout/nav_item" android:id="@+id/nav_worksheet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <include layout="@layout/nav_item" android:id="@+id/nav_exam" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <include layout="@layout/nav_item" android:id="@+id/nav_parent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/mascot_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nav_bar"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/mascot_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="64dp"
            android:layout_marginStart="8dp"
            android:maxWidth="220dp"
            android:background="@drawable/bg_speech_bubble"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="سلام! من هوهو هستم." />

        <com.hoohoomath.app.ui.mascot.HooHooView
            android:id="@+id/mascot_view"
            android:layout_width="@dimen/mascot_size_small"
            android:layout_height="@dimen/mascot_size_small"
            android:layout_gravity="bottom|start" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
