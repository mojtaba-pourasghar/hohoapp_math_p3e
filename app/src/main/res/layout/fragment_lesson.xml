<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lesson_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ بازگشت"
                android:textColor="@color/teal_dark"
                android:textStyle="bold"
                android:padding="6dp"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/lesson_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/lesson_step_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lesson_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- what هوهو is saying right now, with a replay button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/bg_card_orange">

            <TextView
                android:id="@+id/lesson_replay"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="▶"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_circle_teal" />

            <TextView
                android:id="@+id/lesson_say"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/lesson_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:gravity="center"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_card_teal" />

        <!-- the book's "count in groups" picture, when the step has one -->
        <LinearLayout
            android:id="@+id/lesson_visual_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:visibility="gone"
            android:background="@drawable/bg_card_white">

            <TextView
                android:id="@+id/lesson_visual_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted" />

            <FrameLayout
                android:id="@+id/lesson_visual_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lesson_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="14dp" />

    </LinearLayout>
</ScrollView>
